# ---------------------------------------------------------------------------
# Ryuu Agent CLI - example configuration
# Copy to .env and fill in your own key. NEVER commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AI providers
# Keys stay in this file (or in your shell/secret manager); they are never
# printed, logged, or committed. Copy this file to .env and fill in real keys.
# ---------------------------------------------------------------------------

# NVIDIA Integrate API (built-in provider "nvidia"). Get a key from
# https://build.nvidia.com/. Required when "nvidia" is the active provider.
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY

# Optional overrides. Defaults shown.
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b  # note: faster
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Token Harbor — DeepSeek V4.1 Flash Free (built-in provider "tokenharbor").
# OpenAI-compatible Chat Completions API. The ":free" suffix is part of the
# model id; availability and quotas are controlled by Token Harbor and can
# change, so this is not a promise of unlimited free usage.
TOKENHARBOR_API_KEY=
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free

# Active selection for this project. Omit RYUU_PROVIDER to use "nvidia" when
# its key is set, otherwise the first provider that has a key. RYUU_MODEL
# overrides the provider's own *_MODEL variable for this run.
# RYUU_PROVIDER=tokenharbor
# RYUU_MODEL=deepseek-v4.1-flash:free

# Register extra OpenAI-compatible providers without touching the agent code.
# JSON array; each entry needs id, name, baseURL, apiKeyEnv and models.
# Capabilities default to streaming+tools; set them explicitly when a provider
# differs, e.g. "capabilities": { "tools": false, "reasoning": false }.
# RYUU_PROVIDERS=[{"id":"myproxy","name":"My Proxy","baseURL":"https://proxy.example/v1","apiKeyEnv":"MY_PROXY_API_KEY","models":[{"id":"model-a","name":"Model A"}]}]

# Workspace the agent is allowed to touch. Relative paths resolve against cwd.
AGENT_WORKSPACE=.

# debug | info | warn | error | silent
LOG_LEVEL=info

# Optional cap on agent loop steps per task; 0 means no step limit (default).
# AGENT_MAX_TASK_DURATION_MS is the remaining guard against runaway tasks.
AGENT_MAX_STEPS=0

# ask (default) | auto | read-only
AGENT_APPROVAL_POLICY=ask

# Conservative output cap; do not assume large values are accepted by the model.
AGENT_MAX_OUTPUT_TOKENS=4096

# Per-request timeout and bounded retry count for transient provider failures.
AGENT_REQUEST_TIMEOUT_MS=120000
# Abort a response stream that stops sending bytes (0 disables). This is what
# stops a provider from holding one step open for tens of minutes.
AGENT_STREAM_IDLE_TIMEOUT_MS=45000
AGENT_MAX_RETRIES=3

# Reconnect budget for a dropped provider link. The agent keeps a heartbeat
# on screen and retries the request with exponential backoff until it answers.
# 0 = unlimited (retry until the task deadline or /cancel); 1-1000 caps it.
AGENT_MAX_RECOVERY_ATTEMPTS=0
AGENT_RECOVERY_BACKOFF_MS=1000

# Limits that protect the terminal, context window, and disk.
AGENT_MAX_FILE_BYTES=262144
AGENT_MAX_SEARCH_RESULTS=50
AGENT_MAX_TOOL_OUTPUT_BYTES=32768
AGENT_MAX_TASK_DURATION_MS=900000
AGENT_MAX_CONTEXT_CHARS=120000

# Optional multi-provider web search. It tries the configured providers in
# order and falls back automatically when one fails. You.com (free profile) and
# Firecrawl (keyless tier) work without a key; Tavily needs one; Serper is the
# pre-existing REST backend. The query leaves this machine.
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_FALLBACK=true
# Order matters. Allowed: serper,you,firecrawl,duckduckgo,tavily. "none" disables all.
# Default: serper (only if SEARCH_API_KEY is set) -> you -> firecrawl -> duckduckgo -> tavily
# WEB_SEARCH_PROVIDERS=you,firecrawl,duckduckgo,tavily
# WEB_SEARCH_DISABLED=tavily
# Per-attempt timeout (1s-30s), bounded retries only for transient call failures.
# WEB_MCP_TIMEOUT_MS=6000
# WEB_MCP_MAX_RETRIES=1
# Extra provider diagnostics in the log (never prints keys).
# WEB_MCP_DEBUG=false
#
# Optional MCP keys. Never commit real keys.
# YDC_API_KEY=            # You.com: enables contents/discovery tools and higher limits
# FIRECRAWL_API_KEY=      # Firecrawl: raises the keyless credit cap
# TAVILY_API_KEY=         # required by the Tavily remote MCP endpoint
#
# Local DuckDuckGo MCP is disabled by default: it runs third-party code via uvx.
# DUCKDUCKGO_MCP_ENABLED=false
# DUCKDUCKGO_MCP_COMMAND=uvx
# DUCKDUCKGO_MCP_ARGS=free-search-mcp
#
# Serper-compatible REST provider (also part of the fallback chain).
# SEARCH_API_KEY=
# WEB_SEARCH_ENDPOINT=https://google.serper.dev/search
# X-API-KEY | Authorization (sends "Bearer <key>")
# WEB_SEARCH_AUTH_HEADER=X-API-KEY
# Results per query, 1-10. depth=deep doubles it up to the cap.
# WEB_SEARCH_RESULTS=5
# WEB_SEARCH_TIMEOUT_MS=15000

# Allow commands that need shell syntax. Off by default; still approval-gated.
AGENT_ALLOW_SHELL=false

# Optional local storage locations (defaults are inside the workspace).
# AGENT_HISTORY_DIR=.ryuu/sessions
# AGENT_LOG_DIR=.ryuu/logs
